# Token de produção ou teste do Mercado Pago (credenciais da aplicação).
# Sem este valor, o cartão segue pelo WhatsApp.
MERCADO_PAGO_ACCESS_TOKEN=

# Opcional. Em produção, use o endereço público do site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login do painel administrativo (/admin) e da API de produtos.
ADMIN_USER=
ADMIN_PASSWORD=
